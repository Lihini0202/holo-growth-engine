# Copy to .env. All settings are optional; unset integrations run offline
# (rules enrichment, local SQLite CRM, synthetic usage data, demo GEO answers).

# Local store
HOLO_GROWTH_DB=holo_growth.db

# LLM enrichment, content drafting, tone review, GEO checks
ANTHROPIC_API_KEY=
HOLO_GROWTH_MODEL=claude-sonnet-5-5
HOLO_GROWTH_REVIEW_THRESHOLD=0.7

# HubSpot Service Key (Development > Keys > Service keys) or legacy private app
# token; both are sent as a Bearer token. Scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, crm.schemas.contacts.write
# (+ communication_preferences.read_write for email subscriptions)
HUBSPOT_PRIVATE_APP_TOKEN=
# Subscription type that marketing-email consent is pushed to. List them with
# `holo-growth consent types`. Unset: consent travels only as a contact property.
HUBSPOT_SUBSCRIPTION_ID=

# Holo Supabase (read-only). The service key is a secret; never commit or log it.
HOLO_SUPABASE_URL=
HOLO_SUPABASE_SERVICE_KEY=

# Salesforce (Lead object) through an External Client App with the client credentials
# flow. Set CRM_PROVIDER=salesforce when HubSpot credentials are also present.
CRM_PROVIDER=
SALESFORCE_DOMAIN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# GA4 Data API (requires the `ga4` extra). Path to a service-account JSON key
# with Viewer access to the property.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_FILE=
GA4_SIGNUP_EVENT=sign_up

# Additional GEO providers via OpenRouter (comma-separated model IDs)
OPENROUTER_API_KEY=
HOLO_GEO_OPENROUTER_MODELS=openai/gpt-5,google/gemini-3-pro

# Domains permitted in campaign copy links
HOLO_LINK_DOMAINS=holo-tan.vercel.app

# Directory the MCP server reads signup files from
HOLO_GROWTH_INBOX=inbox
