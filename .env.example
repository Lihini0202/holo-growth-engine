# Copy to .env and fill in what you have. Everything is optional:
# with nothing set, the engine runs fully offline (rules enrichment,
# local SQLite CRM, synthetic Holo users, demo GEO answers).

# Local store
HOLO_GROWTH_DB=holo_growth.db

# LLM enrichment, content drafting, tone review, GEO checks
ANTHROPIC_API_KEY=
HOLO_GROWTH_MODEL=claude-sonnet-5-5
HOLO_GROWTH_REVIEW_THRESHOLD=0.7

# HubSpot private app token. Scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, crm.schemas.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# Holo's Supabase (read-only use). Service key: keep it out of git and CI logs.
HOLO_SUPABASE_URL=
HOLO_SUPABASE_SERVICE_KEY=

# Extra GEO providers through OpenRouter (comma-separated model ids)
OPENROUTER_API_KEY=
HOLO_GEO_OPENROUTER_MODELS=openai/gpt-5,google/gemini-3-pro

# Campaign copy may only link to these domains
HOLO_LINK_DOMAINS=holo-tan.vercel.app

# MCP server only reads signup files from this folder
HOLO_GROWTH_INBOX=inbox
